# Copy to .env and fill in. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pistas
DB_USER=pistas
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Signs login tokens. Use a long random value.
JWT_SECRET=
JWT_MINUTES=30

# Passwords for the seeded demo accounts (scripts/seed.py). One variable for all of them.
SEED_PASSWORD=

# E-mail alerts to ANA when a controller reports a flight. In the full stack the default is the
# Mailpit container (inbox at http://localhost:8025). For a real account fill these in; leave
# SMTP_HOST empty to switch the alerts off.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_STARTTLS=true
#MAIL_FROM=
