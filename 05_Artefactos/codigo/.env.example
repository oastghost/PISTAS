# Copy to .env and fill in. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pistas
DB_USER=pistas
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Signs login tokens. Use a long random value.
JWT_SECRET=
JWT_MINUTES=30

# Passwords for the seeded demo accounts (scripts/seed.py). One variable for all of them.
SEED_PASSWORD=
